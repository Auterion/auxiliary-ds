{
  "name": "@auxiliary/docs",
  "version": "0.0.0",
  "description": "Auxiliary documentation site (VitePress). Runs at http://localhost:5173.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev --port 5173",
    "build": "vitepress build",
    "preview": "vitepress preview --port 5173",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "gen:props": "node scripts/gen-props.mjs",
    "predev": "node scripts/gen-props.mjs"
  },
  "dependencies": {
    "@auxiliary/brand": "workspace:*",
    "@auxiliary/css": "workspace:*",
    "@auxiliary/icons": "workspace:*",
    "@auxiliary/tokens": "workspace:*",
    "@auxiliary/viz": "workspace:*",
    "@auxiliary/vue": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^4.0.0",
    "vitepress": "^1.5.0",
    "vitest": "^4.1.7",
    "vue-component-meta": "^2.2.12",
    "vue-tsc": "^2.2.0"
  }
}
