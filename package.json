{
  "name": "auxiliary-ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Auterion's design system — tokens, components, and patterns.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "figma:diff": "pnpm --filter @auxiliary/figma-sync diff",
    "design-team": "node design-team/build.mjs",
    "design-team:check": "node design-team/build.mjs --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.3.0",
    "turbo": "~2.9.14",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
