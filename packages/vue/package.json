{
  "name": "@auxiliary/vue",
  "version": "0.0.0",
  "description": "Vue 3 primitives for Auxiliary, styled via @auxiliary/css recipes and utilities.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/auxiliary-vue.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auxiliary/css": "workspace:*",
    "@auxiliary/tokens": "workspace:*",
    "reka-ui": "^2.9.8"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
