{
  "name": "@auxiliary/icons",
  "version": "0.0.0",
  "description": "Typed <Icon> Vue component over a curated Auterion glyph set. Registry is generated from inputs/*.svg and committed — no vendor dependency, no registry auth.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/auxiliary-icons.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "sync": "node scripts/sync.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit",
    "test": "echo \"@auxiliary/icons test — TODO\" && exit 0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
