{
  "name": "@auxiliary/icons",
  "version": "0.0.0",
  "description": "Typed <Icon> Vue component over a curated set of Font Awesome Pro Sharp glyphs + an Auterion operational kit. Registry is generated and committed — consumers do not need FA Pro access to use the package.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/auxiliary-icons.js"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "sync": "node scripts/sync.mjs",
    "lint": "echo \"@auxiliary/icons lint — TODO\" && exit 0",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit",
    "test": "echo \"@auxiliary/icons test — TODO\" && exit 0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "optionalDependencies": {
    "@fortawesome/sharp-light-svg-icons": "^6.7.0",
    "@fortawesome/sharp-regular-svg-icons": "^6.7.0",
    "@fortawesome/sharp-solid-svg-icons": "^6.7.0",
    "@fortawesome/sharp-thin-svg-icons": "^6.7.0"
  }
}
