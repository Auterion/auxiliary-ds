{
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter Variable", "Inter", "system-ui", "sans-serif"]
    },
    "display": {
      "$type": "fontFamily",
      "$value": ["Inter Display", "Inter Variable", "Inter", "system-ui", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "monospace"]
    }
  },
  "font-weight": {
    "regular":  { "$type": "fontWeight", "$value": 400 },
    "medium":   { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold":     { "$type": "fontWeight", "$value": 700 }
  },
  "text": {
    "2xs":  { "$type": "dimension", "$value": "10px" },
    "xs":   { "$type": "dimension", "$value": "12px" },
    "sm":   { "$type": "dimension", "$value": "14px" },
    "base": { "$type": "dimension", "$value": "16px" },
    "lg":   { "$type": "dimension", "$value": "18px" },
    "xl":   { "$type": "dimension", "$value": "20px" },
    "2xl":  { "$type": "dimension", "$value": "24px" },
    "3xl":  { "$type": "dimension", "$value": "30px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "26px" } } } },
    "4xl":  { "$type": "dimension", "$value": "40px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "30px" } } } },
    "5xl":  { "$type": "dimension", "$value": "48px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "34px" } } } },
    "6xl":  { "$type": "dimension", "$value": "60px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "40px" } } } },
    "7xl":  { "$type": "dimension", "$value": "72px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "46px" } } } },
    "8xl":  { "$type": "dimension", "$value": "80px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "52px" } } } },
    "9xl":  { "$type": "dimension", "$value": "96px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "60px" } } } },
    "10xl": { "$type": "dimension", "$value": "128px",
              "$extensions": { "com.auterion.auxiliary": { "fluid": { "min": "72px" } } } },

    "caption": { "$type": "dimension", "$value": "{text.xs}" },
    "label":   { "$type": "dimension", "$value": "{text.sm}" },
    "body":    { "$type": "dimension", "$value": "{text.base}" },
    "body-lg": { "$type": "dimension", "$value": "{text.lg}" },
    "title":   { "$type": "dimension", "$value": "{text.xl}" },
    "heading": { "$type": "dimension", "$value": "{text.2xl}" },
    "display": { "$type": "dimension", "$value": "{text.6xl}" }
  },
  "leading": {
    "tight":   { "$type": "number", "$value": 1.2 },
    "snug":    { "$type": "number", "$value": 1.35 },
    "normal":  { "$type": "number", "$value": 1.5 },
    "loose":   { "$type": "number", "$value": 1.7 },
    "body":    { "$type": "number", "$value": 1.4 },
    "subhead": { "$type": "number", "$value": 1.25 },
    "heading": { "$type": "number", "$value": 1.15 },
    "title":   { "$type": "number", "$value": 1.1 },
    "display": { "$type": "number", "$value": 1.0 }
  },
  "tracking": {
    "tighter": { "$type": "dimension", "$value": "-0.05em" },
    "tight":   { "$type": "dimension", "$value": "-0.01em" },
    "normal":  { "$type": "dimension", "$value": "0em" },
    "wide":    { "$type": "dimension", "$value": "0.02em" },
    "body":    { "$type": "dimension", "$value": "-0.02em" },
    "subhead": { "$type": "dimension", "$value": "-0.03em" },
    "display": { "$type": "dimension", "$value": "-0.04em" },
    "caps":    { "$type": "dimension", "$value": "0.05em" }
  },

  "text-leading": {
    "$description": "Per-size line-height paired to the text scale (Figma node 1388:223): tightens as size grows, 1.4 body → 1.0 display. Emitted as Tailwind --text-<step>--line-height so every text-* utility carries it automatically; `leading` above stays the role-based vocabulary.",
    "2xs":  { "$type": "number", "$value": 1.4 },
    "xs":   { "$type": "number", "$value": 1.4 },
    "sm":   { "$type": "number", "$value": 1.4 },
    "base": { "$type": "number", "$value": 1.4 },
    "lg":   { "$type": "number", "$value": 1.4 },
    "xl":   { "$type": "number", "$value": 1.4 },
    "2xl":  { "$type": "number", "$value": 1.25 },
    "3xl":  { "$type": "number", "$value": 1.25 },
    "4xl":  { "$type": "number", "$value": 1.15 },
    "5xl":  { "$type": "number", "$value": 1.12 },
    "6xl":  { "$type": "number", "$value": 1.08 },
    "7xl":  { "$type": "number", "$value": 1.05 },
    "8xl":  { "$type": "number", "$value": 1 },
    "9xl":  { "$type": "number", "$value": 1 },
    "10xl": { "$type": "number", "$value": 1 }
  },
  "text-tracking": {
    "$description": "Per-size letter-spacing paired to the text scale: increasingly negative as size grows (-0.02em small → -0.05em display). Emitted as Tailwind --text-<step>--letter-spacing. 2xs stays at 0 — tiny type must not tighten.",
    "2xs":  { "$type": "dimension", "$value": "0em" },
    "xs":   { "$type": "dimension", "$value": "-0.02em" },
    "sm":   { "$type": "dimension", "$value": "-0.02em" },
    "base": { "$type": "dimension", "$value": "-0.02em" },
    "lg":   { "$type": "dimension", "$value": "-0.02em" },
    "xl":   { "$type": "dimension", "$value": "-0.03em" },
    "2xl":  { "$type": "dimension", "$value": "-0.03em" },
    "3xl":  { "$type": "dimension", "$value": "-0.04em" },
    "4xl":  { "$type": "dimension", "$value": "-0.04em" },
    "5xl":  { "$type": "dimension", "$value": "-0.04em" },
    "6xl":  { "$type": "dimension", "$value": "-0.045em" },
    "7xl":  { "$type": "dimension", "$value": "-0.045em" },
    "8xl":  { "$type": "dimension", "$value": "-0.045em" },
    "9xl":  { "$type": "dimension", "$value": "-0.05em" },
    "10xl": { "$type": "dimension", "$value": "-0.05em" }
  },

  "type": {
    "product": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.3xl}",
          "fontWeight": "{font-weight.semibold}",
          "lineHeight": "{leading.tight}",
          "letterSpacing": "{tracking.subhead}"
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.2xl}",
          "fontWeight": "{font-weight.semibold}",
          "lineHeight": "{leading.heading}",
          "letterSpacing": "{tracking.tight}"
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.xl}",
          "fontWeight": "{font-weight.semibold}",
          "lineHeight": "{leading.subhead}",
          "letterSpacing": "{tracking.tight}"
        }
      },
      "body-lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.lg}",
          "fontWeight": "{font-weight.medium}",
          "lineHeight": "{leading.normal}",
          "letterSpacing": "{tracking.normal}"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.base}",
          "fontWeight": "{font-weight.regular}",
          "lineHeight": "{leading.normal}",
          "letterSpacing": "{tracking.normal}"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.sm}",
          "fontWeight": "{font-weight.medium}",
          "lineHeight": "{leading.snug}",
          "letterSpacing": "{tracking.normal}"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.xs}",
          "fontWeight": "{font-weight.regular}",
          "lineHeight": "{leading.snug}",
          "letterSpacing": "{tracking.normal}"
        }
      }
    },
    "marketing": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{text.6xl}",
          "fontWeight": "{font-weight.medium}",
          "lineHeight": "{leading.display}",
          "letterSpacing": "{tracking.tighter}"
        }
      },
      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{text.5xl}",
          "fontWeight": "{font-weight.medium}",
          "lineHeight": "{leading.title}",
          "letterSpacing": "{tracking.tighter}"
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{text.4xl}",
          "fontWeight": "{font-weight.medium}",
          "lineHeight": "{leading.heading}",
          "letterSpacing": "{tracking.display}"
        }
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{text.3xl}",
          "fontWeight": "{font-weight.medium}",
          "lineHeight": "{leading.tight}",
          "letterSpacing": "{tracking.display}"
        }
      },
      "lead": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.xl}",
          "fontWeight": "{font-weight.regular}",
          "lineHeight": "{leading.normal}",
          "letterSpacing": "{tracking.tight}"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.lg}",
          "fontWeight": "{font-weight.regular}",
          "lineHeight": "{leading.normal}",
          "letterSpacing": "{tracking.tight}"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.sans}",
          "fontSize": "{text.sm}",
          "fontWeight": "{font-weight.semibold}",
          "lineHeight": "{leading.snug}",
          "letterSpacing": "{tracking.tight}"
        }
      }
    }
  }
}
