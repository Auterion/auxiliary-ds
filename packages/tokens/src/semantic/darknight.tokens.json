{
  "darknight": {
    "bg": {
      "canvas":   { "$type": "color", "$value": "{color.primitive.black}" },
      "surface":  { "$type": "color", "$value": "{color.primitive.black}" },
      "elevated": { "$type": "color", "$value": "{color.primitive.night.brown.700}" },
      "muted":    { "$type": "color", "$value": "{color.primitive.night.brown.800}" },
      "hover":    { "$type": "color", "$value": "{color.primitive.night.brown.700}" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{color.primitive.night.amber.100}" },
      "secondary": { "$type": "color", "$value": "{color.primitive.night.amber.200}" },
      "muted":     { "$type": "color", "$value": "{color.primitive.night.amber.300}" },
      "inverse":   { "$type": "color", "$value": "{color.primitive.black}" }
    },
    "accent": {
      "default":    { "$type": "color", "$value": "{color.primitive.night.amber.100}" },
      "foreground": { "$type": "color", "$value": "{color.primitive.black}" },
      "hover":      { "$type": "color", "$value": "{color.primitive.night.amber.50}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.primitive.night.brown.700}" },
      "strong":  { "$type": "color", "$value": "{color.primitive.night.brown.600}" },
      "focus":   { "$type": "color", "$value": "{color.primitive.night.brown.500}" }
    },
    "input": {
      "bg":     { "$type": "color", "$value": "{color.primitive.black}" },
      "border": { "$type": "color", "$value": "{color.primitive.night.brown.600}" }
    },
    "status": {
      "alarm":    { "bg": { "$type": "color", "$value": "{color.primitive.night.status.alarm}" },    "fg": { "$type": "color", "$value": "{color.primitive.black}" },          "border": { "$type": "color", "$value": "{color.primitive.night.status.alarm}" } },
      "warning":  { "bg": { "$type": "color", "$value": "{color.primitive.night.status.warning}" },  "fg": { "$type": "color", "$value": "{color.primitive.black}" },          "border": { "$type": "color", "$value": "{color.primitive.night.status.warning}" } },
      "caution":  { "bg": { "$type": "color", "$value": "{color.primitive.night.status.caution}" },  "fg": { "$type": "color", "$value": "{color.primitive.black}" },          "border": { "$type": "color", "$value": "{color.primitive.night.status.caution}" } },
      "advisory": { "bg": { "$type": "color", "$value": "{color.primitive.night.status.advisory}" }, "fg": { "$type": "color", "$value": "{color.primitive.night.amber.50}" },  "border": { "$type": "color", "$value": "{color.primitive.night.status.advisory}" } },
      "nominal":  { "bg": { "$type": "color", "$value": "{color.primitive.night.status.nominal}" },  "fg": { "$type": "color", "$value": "{color.primitive.black}" },          "border": { "$type": "color", "$value": "{color.primitive.night.status.nominal}" } }
    }
  }
}
