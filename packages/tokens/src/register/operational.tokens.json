{
  "register": {
    "$description": "The operational register: denser, tighter, calmer. Every override is one rung down the corresponding global scale — expressed as an alias rather than a literal so the relationship is explicit and a change to a global rung propagates here. GTC: no tier below global stores raw values.",
    "operational": {
      "control": {
        "height": {
          "xs": { "$type": "dimension", "$value": "{global.spacing.6}" },
          "sm": { "$type": "dimension", "$value": "{global.control.height.xs}" },
          "md": { "$type": "dimension", "$value": "{global.control.height.sm}" },
          "lg": { "$type": "dimension", "$value": "{global.control.height.md}" }
        }
      },
      "radius": {
        "sm": { "$type": "dimension", "$value": "{global.radius.xs}" },
        "md": { "$type": "dimension", "$value": "{global.radius.sm}" },
        "lg": { "$type": "dimension", "$value": "{global.radius.md}" }
      },
      "duration": {
        "fast": { "$type": "duration", "$value": "{global.duration.instant}" },
        "base": { "$type": "duration", "$value": "{global.duration.fast}" },
        "slow": { "$type": "duration", "$value": "{global.duration.base}" }
      }
    }
  }
}
