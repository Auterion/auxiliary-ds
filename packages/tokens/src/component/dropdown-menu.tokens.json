{
  "component": {
    "dropdown-menu": {
      "min-width": {
        "$type": "dimension",
        "$value": "{global.size.container.2xs}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{global.radius.md}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{global.spacing.1}"
      },
      "item": {
        "height": {
          "$type": "dimension",
          "$value": "{global.spacing.8}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{global.radius.xs}",
          "$description": "Concentric with the popover: outer radius (md, 6px) minus the container padding (4px) = 2px. A 4px inner inside a 6px outer with a 4px inset reads as a mis-struck corner."
        },
        "padding-x": {
          "$type": "dimension",
          "$value": "{global.spacing.2}"
        }
      },
      "label": {
        "padding-x": {
          "$type": "dimension",
          "$value": "{global.spacing.2}"
        },
        "padding-y": {
          "$type": "dimension",
          "$value": "{global.spacing.1_5}"
        }
      },
      "separator": {
        "margin-y": {
          "$type": "dimension",
          "$value": "{global.spacing.1}"
        }
      }
    }
  }
}
