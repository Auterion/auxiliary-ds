{
  "component": {
    "combobox": {
      "$description": "See select \u2014 item.padding-inline-start is derived in the recipe, not a token. content.max-height shares 288px with popover.width by coincidence, not intent; if either moves, it moves alone.",
      "height": {
        "sm": {
          "$type": "dimension",
          "$value": "{global.control.height.sm}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{global.control.height.md}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{global.control.height.lg}"
        }
      },
      "padding-x": {
        "sm": {
          "$type": "dimension",
          "$value": "{global.spacing.2_5}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{global.spacing.3}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{global.spacing.3_5}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{global.spacing.2}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{global.radius.md}"
      },
      "icon-size": {
        "$type": "dimension",
        "$value": "{global.size.icon.sm}"
      },
      "content": {
        "radius": {
          "$type": "dimension",
          "$value": "{global.radius.md}"
        },
        "max-height": {
          "$type": "dimension",
          "$value": "{global.size.container.xs}"
        }
      },
      "viewport": {
        "padding": {
          "$type": "dimension",
          "$value": "{global.spacing.1}"
        }
      },
      "item": {
        "height": {
          "$type": "dimension",
          "$value": "{global.spacing.8}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{global.radius.xs}",
          "$description": "Concentric with the popover: outer radius (md, 6px) minus the container padding (4px) = 2px. A 4px inner inside a 6px outer with a 4px inset reads as a mis-struck corner."
        },
        "padding-inline-end": {
          "$type": "dimension",
          "$value": "{global.spacing.2}"
        },
        "indicator": {
          "inset-inline-start": {
            "$type": "dimension",
            "$value": "{global.spacing.2}"
          }
        },
        "icon-size": {
          "$type": "dimension",
          "$value": "{global.size.icon.sm}",
          "$description": "Raised one rung when the inline glyph set was unified on stroke-width 2 \u2014 the check was carrying its weight with a heavier stroke (3) than every other glyph in the same control, which read as two different icon sets side by side."
        }
      },
      "empty": {
        "padding-x": {
          "$type": "dimension",
          "$value": "{global.spacing.2}"
        },
        "padding-y": {
          "$type": "dimension",
          "$value": "{global.spacing.6}"
        }
      },
      "separator": {
        "margin-y": {
          "$type": "dimension",
          "$value": "{global.spacing.1}"
        }
      }
    }
  }
}
