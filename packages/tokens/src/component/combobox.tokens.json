{
  "component": {
    "combobox": {
      "$description": "See select — item.padding-inline-start is derived in the recipe, not a token. content.max-height shares 288px with popover.width by coincidence, not intent; if either moves, it moves alone.",
      "height": {
        "sm": {
          "$type": "dimension",
          "$value": "{global.control.height.sm}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{global.control.height.md}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{global.control.height.lg}"
        }
      },
      "padding-x": {
        "sm": {
          "$type": "dimension",
          "$value": "{global.spacing.2_5}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{global.spacing.3}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{global.spacing.3_5}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{global.spacing.2}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{global.radius.md}"
      },
      "icon-size": {
        "$type": "dimension",
        "$value": "{global.size.icon.sm}"
      },
      "content": {
        "radius": {
          "$type": "dimension",
          "$value": "{global.radius.md}"
        },
        "max-height": {
          "$type": "dimension",
          "$value": "{global.size.container.xs}"
        }
      },
      "viewport": {
        "padding": {
          "$type": "dimension",
          "$value": "{global.spacing.1}"
        }
      },
      "item": {
        "height": {
          "$type": "dimension",
          "$value": "{global.spacing.8}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{global.radius.sm}"
        },
        "padding-inline-end": {
          "$type": "dimension",
          "$value": "{global.spacing.2}"
        },
        "indicator": {
          "inset-inline-start": {
            "$type": "dimension",
            "$value": "{global.spacing.2}"
          }
        },
        "icon-size": {
          "$type": "dimension",
          "$value": "{global.size.icon.xs}"
        }
      },
      "empty": {
        "padding-x": {
          "$type": "dimension",
          "$value": "{global.spacing.2}"
        },
        "padding-y": {
          "$type": "dimension",
          "$value": "{global.spacing.6}"
        }
      },
      "separator": {
        "margin-y": {
          "$type": "dimension",
          "$value": "{global.spacing.1}"
        }
      }
    }
  }
}
