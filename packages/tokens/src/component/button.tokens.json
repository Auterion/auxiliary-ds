{
  "component": {
    "button": {
      "height": {
        "sm": {
          "$type": "dimension",
          "$value": "{global.control.height.sm}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{global.control.height.md}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{global.control.height.lg}"
        }
      },
      "padding-x": {
        "sm": {
          "$type": "dimension",
          "$value": "{global.spacing.3}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{global.spacing.4}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{global.spacing.6}"
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{global.spacing.2}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{global.radius.md}"
      }
    }
  }
}
