{
  "global": {
    "spacing": {
      "0":    { "$type": "dimension", "$value": "0px" },
      "0_5":  { "$type": "dimension", "$value": "2px" },
      "0_75": { "$type": "dimension", "$value": "3px", "$description": "Sole consumer is the GuardedAction progress fill. Off the 4px grid but pixel-preserving; retiring it to spacing.1 (4px) is a visual change and belongs in its own commit." },
      "1":    { "$type": "dimension", "$value": "4px" },
      "1_5":  { "$type": "dimension", "$value": "6px" },
      "2":    { "$type": "dimension", "$value": "8px" },
      "2_5":  { "$type": "dimension", "$value": "10px" },
      "3":    { "$type": "dimension", "$value": "12px" },
      "3_5":  { "$type": "dimension", "$value": "14px" },
      "4":    { "$type": "dimension", "$value": "16px" },
      "5":    { "$type": "dimension", "$value": "20px" },
      "6":    { "$type": "dimension", "$value": "24px" },
      "8":    { "$type": "dimension", "$value": "32px" },
      "9":    { "$type": "dimension", "$value": "36px", "$description": "Sole consumer is the Switch track width. Deliberately NOT control.height.md (also 36px): that coincidence would shrink the track under [data-register=\"operational\"] while the thumb and throw stayed put." },
      "10":   { "$type": "dimension", "$value": "40px" },
      "12":   { "$type": "dimension", "$value": "48px" },
      "16":   { "$type": "dimension", "$value": "64px" },
      "20":   { "$type": "dimension", "$value": "80px" },
      "24":   { "$type": "dimension", "$value": "96px" }
    }
  }
}
