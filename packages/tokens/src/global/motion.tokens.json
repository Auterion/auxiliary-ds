{
  "global": {
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms", "$description": "Not used directly — the rung the operational register shifts `fast` down to, so register overrides alias a global rung instead of restating a literal." },
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" }
    },
    "ease": {
      "out":    { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "in-out": { "$type": "cubicBezier", "$value": "cubic-bezier(0.65, 0, 0.35, 1)" }
    }
  }
}
