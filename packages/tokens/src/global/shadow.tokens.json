{
  "global": {
    "shadow": {
      "sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.08)" },
      "md": { "$type": "shadow", "$value": "0 4px 8px -2px rgb(0 0 0 / 0.10), 0 2px 4px -2px rgb(0 0 0 / 0.06)" },
      "lg": { "$type": "shadow", "$value": "0 12px 24px -6px rgb(0 0 0 / 0.12), 0 4px 8px -4px rgb(0 0 0 / 0.08)" }
    }
  }
}
