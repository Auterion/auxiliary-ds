{
  "name": "@auxiliary/css",
  "version": "0.0.0",
  "description": "Auxiliary's Tailwind v4 styling layer: theme entry, utility surface, and framework-agnostic recipes.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "theme.css",
    "fonts",
    "recipes",
    "utils",
    "format"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "import": "./dist/recipes/index.js"
    },
    "./recipes/*": {
      "types": "./dist/recipes/*.d.ts",
      "import": "./dist/recipes/*.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "fonts:sync": "node scripts/sync-fonts.mjs"
  },
  "dependencies": {
    "@auxiliary/tokens": "workspace:*",
    "mgrs": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@types/node": "^25.9.1",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.7"
  }
}
