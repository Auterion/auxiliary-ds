{
  "name": "@auxiliary/brand",
  "version": "0.0.0",
  "description": "Auterion brand-asset layer: org + product marks, wordmarks and lockups, a machine-readable usage manifest (clearspace / min-size / tone-by-theme / forbidden contexts), and a typed <Logo> Vue component. Masters live in assets/ and are inlined into a generated registry at build — consumers ship no raw SVGs.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "brand.manifest.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Logo": {
      "types": "./dist/Logo.vue.d.ts",
      "import": "./dist/Logo.vue.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./brand.manifest.json": "./brand.manifest.json"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "sync": "node scripts/sync.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@auxiliary/tokens": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
